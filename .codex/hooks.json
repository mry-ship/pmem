{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|mcp__pmem__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "pmemw hook pre-tool --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|mcp__pmem__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "pmemw hook post-tool --agent codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
