{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pmem hook prompt --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|mcp__pmem__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "pmem hook pre-tool --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|mcp__pmem__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "pmem hook post-tool --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pmem hook compact --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pmem hook stop --agent codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
