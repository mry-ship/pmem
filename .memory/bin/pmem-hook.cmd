@echo off
rem Hook entry generated by pmem init: run pmem when installed, otherwise tell the agent instead of failing silently.
where pmem >nul 2>nul
if not errorlevel 1 (
  call pmem hook %*
  exit /b
)
if /i "%~1"=="session" goto session
if /i "%~1"=="pre-tool" goto allow
if /i "%~1"=="prompt" goto continue
echo {}
exit /b 0
:session
echo {"additional_context": "[pmem] \u672c\u673a\u627e\u4e0d\u5230 pmem \u547d\u4ee4\uff1a\u672c\u9879\u76ee\u7684\u7814\u53d1\u8bb0\u5fc6\u68c0\u67e5\u548c\u6539\u4ee3\u7801\u524d\u7684\u95f8\u95e8\u90fd\u6ca1\u6709\u751f\u6548\u3002\u8bf7\u5728\u8fd9\u6b21\u56de\u590d\u91cc\u5148\u544a\u8bc9\u7528\u6237\uff1a\u6309\u9879\u76ee README \u5b89\u88c5 pmem\uff08\u9700\u8981 uv\uff09\uff0c\u88c5\u597d\u540e\u91cd\u542f Cursor\u3002"}
exit /b 0
:allow
echo {"permission":"allow"}
exit /b 0
:continue
echo {"continue":true}
exit /b 0
