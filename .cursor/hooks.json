{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "pmem hook prompt"
      }
    ],
    "preToolUse": [
      {
        "command": "pmem hook pre-tool",
        "matcher": "Write|StrReplace|Edit|MultiEdit|EditNotebook|Delete|Shell|MCP|record_memory|search_memory",
        "failClosed": false
      }
    ],
    "postToolUse": [
      {
        "command": "pmem hook post-tool",
        "matcher": "Read|Grep|Glob|SemanticSearch|codebase_search|Shell"
      }
    ],
    "afterMCPExecution": [
      {
        "command": "pmem hook after-mcp"
      }
    ],
    "afterFileEdit": [
      {
        "command": "pmem hook edited"
      }
    ],
    "preCompact": [
      {
        "command": "pmem hook compact"
      }
    ],
    "stop": [
      {
        "command": "pmem hook stop",
        "loop_limit": 1
      }
    ],
    "sessionStart": [
      {
        "command": ".memory/bin/pmem-hook session"
      }
    ]
  }
}
